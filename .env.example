# Contraseña para entrar a la plataforma (obligatoria)
APP_PASSWORD=cambiame

# Opcional: cualquier texto largo y al azar. Si no está, se deriva de APP_PASSWORD
SESSION_SECRET=

# Credenciales de la app SMS Gateway for Android (sección Cloud Server)
SMSGATE_USER=
SMSGATE_PASS=

# Opcional: base de datos Upstash Redis para enlaces cortos (/c/abc1234)
# Si conectás Upstash desde Vercel (Storage), estas variables se cargan solas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Entrar con Google (misma cuenta que usás en Mensajes)
# Client ID de tipo "Aplicación web" creado en Google Cloud Console
GOOGLE_CLIENT_ID=
# Mails autorizados, separados por coma
ALLOWED_EMAILS=tumail@gmail.com
